# Build artefacts & local state
# `**/` is required for nested artefacts: Docker anchors patterns without it
# to the context root. Runtime dirs below stay root-anchored on purpose —
# `**/data/` would also drop backend/services/lipidref/data/ (parquet refs).
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/venv/
**/env/

# Local runtime data (the container mounts a writable /data volume)
/data/
/backend/data/
/storage/
/backend/storage/
/backups/
/backend/backups/
**/.env
**/*.db
**/*.sqlite
**/*.sqlite3

# Cache / OS
.DS_Store
Thumbs.db
**/*.log

# Docs / manuscripts not needed for the running app
**/*.docx
**/*.pdf

# Git
.git/
.gitignore
