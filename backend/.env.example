# LipidoX — Environment Configuration (SQLite)
#
# Copy this file to ".env" and edit. Variables can also be supplied by the
# container environment. The defaults below (no .env) store everything under
# ./data next to the backend folder; the container sets /data through ENV.

# SQLite database file. The container uses sqlite:////data/lipidportal.db.
# DATABASE_URL=sqlite:////data/lipidportal.db

# JWT settings. Leave JWT_SECRET empty to let the app generate and persist a
# random key at <DATA_DIR>/.jwt_secret. If you set it, use >= 32 characters.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
JWT_ISSUER=lipidportal
JWT_AUDIENCE=lipidportal-client

# Local file storage root (uploaded matrices, metadata, results).
# The container uses /data/storage.
# STORAGE_ROOT=/data/storage

# CORS origins (comma-separated). Keep this list explicit; the client and API
# normally share an origin, so production rarely needs extra entries.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5000,http://127.0.0.1:5173,http://127.0.0.1:5500

# Background task worker pool (lower = less memory)
MAX_WORKERS=2

# Upload/quota limits
MAX_UPLOAD_MB=200
PROJECT_QUOTA_MB=5120

# Backup settings. The container uses /data/backups.
# BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_TOTAL_MB=10240
# Set to enable AES-GCM encryption of backup archives (.zip.enc)
BACKUP_ENCRYPTION_KEY=

# /idconvert CSV downloads expire after this many minutes
EXPORT_TTL_MINUTES=60

# API docs are off by default
ENABLE_DOCS=0

# Host allowlist for self-hosting (comma-separated, "*" = any)
ALLOWED_HOSTS=*

# Set to 0 to stop sending gene names to NCBI/Enrichr
EXTERNAL_ENRICHMENT_ENABLED=1
# Abort a single remote enrichment call after this many seconds
EXTERNAL_CALL_TIMEOUT_SECONDS=120

# Direct TLS when running `python main.py` (leave empty behind a proxy)
SSL_CERTFILE=
SSL_KEYFILE=

# Where persistent data lives. Defaults to ./data next to the backend folder;
# the container sets DATA_DIR=/data.
# DATA_DIR=/data
