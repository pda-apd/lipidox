# LipidoX — Environment Configuration (SQLite)
#
# Copy this file to ".env" and edit. Variables can also be supplied by the
# container environment.

# SQLite database file. In the container this is sqlite:////data/lipidportal.db
# (DATA_DIR=/data). Locally the default creates ./data/lipidportal.db.
DATABASE_URL=sqlite:////data/lipidportal.db

# JWT settings — CHANGE THE SECRET IN PRODUCTION (use a long random string)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Local file storage root (uploaded matrices, metadata, results)
# In the container use: /data/storage
STORAGE_ROOT=/data/storage

# CORS origins (comma-separated, "*" allows all — fine when client & API
# share the same origin, which is the default v4 setup)
CORS_ORIGINS=*

# Background task worker pool
MAX_WORKERS=2

# Backup settings
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=7

# Where persistent data lives. Defaults to ./data next to the backend folder.
# DATA_DIR=/data
